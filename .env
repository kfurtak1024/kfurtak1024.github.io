# Committed development defaults. CI overrides both from repository secrets,
# and scripts/verify.mjs --require-secrets asserts these values are gone from a
# production build. Put real values in .env.local (gitignored) to build locally
# as production does.

# base64 of dev@example.invalid -- the email is decoded in the browser, so this
# is scraper obfuscation only, not a secret.
VITE_SITE_EMAIL_BASE64=ZGV2QGV4YW1wbGUuaW52YWxpZA==
